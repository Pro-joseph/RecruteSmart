{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "cv_analysis",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "years_experience_total",
        "location",
        "skills",
        "languages",
        "education",
        "recent_positions",
        "criteria",
        "summary",
        "strengths",
        "gaps"
    ],
    "properties": {
        "years_experience_total": { "type": "number", "minimum": 0, "maximum": 60 },
        "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["city", "country"],
            "properties": {
                "city": { "type": "string" },
                "country": { "type": "string" }
            }
        },
        "skills": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string" }
        },
        "languages": {
            "type": "array",
            "maxItems": 20,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "level"],
                "properties": {
                    "name": { "type": "string" },
                    "level": { "type": "string" }
                }
            }
        },
        "education": {
            "type": "array",
            "maxItems": 20,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["degree", "field", "institution", "year"],
                "properties": {
                    "degree": { "type": "string" },
                    "field": { "type": "string" },
                    "institution": { "type": "string" },
                    "year": { "type": "integer", "minimum": 1950, "maximum": 2100 }
                }
            }
        },
        "recent_positions": {
            "type": "array",
            "maxItems": 15,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "company", "months"],
                "properties": {
                    "title": { "type": "string" },
                    "company": { "type": "string" },
                    "months": { "type": "integer", "minimum": 0, "maximum": 120 }
                }
            }
        },
        "criteria": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
                "required_skills": { "$ref": "#/$defs/skillsCriteria" },
                "preferred_skills": { "$ref": "#/$defs/skillsCriteria" },
                "experience": { "$ref": "#/$defs/simpleCriteria" },
                "education": { "$ref": "#/$defs/simpleCriteria" },
                "languages": { "$ref": "#/$defs/simpleCriteria" }
            }
        },
        "summary": { "type": "string", "maxLength": 600 },
        "strengths": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string" }
        },
        "gaps": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string" }
        },
        "anomalies": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string" }
        }
    },
    "$defs": {
        "simpleCriteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["score", "evidence"],
            "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "evidence": { "type": "string" }
            }
        },
        "skillsCriteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["score", "evidence", "matched", "missing"],
            "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "evidence": { "type": "string" },
                "matched": { "type": "array", "items": { "type": "string" } },
                "missing": { "type": "array", "items": { "type": "string" } }
            }
        }
    }
}
