# RecruteSmart — root env template (Lot 0)
# Copy per service as needed. Canonical per-service file: backend/.env (see backend/.env.example after Laravel init).
# Values from spec Part II §11.2.

APP_ENV=local
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=recruitment
DB_USERNAME=recruit
DB_PASSWORD=recruit

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:8000
FRONTEND_URL=http://localhost:4200

FILESYSTEM_DISK=private

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@recrutement.example.com
MAIL_FROM_NAME=RecruteSmart

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_MAX_INPUT_CHARS=30000
LLM_DAILY_LIMIT_PER_USER=300
PROMPT_VERSION=v1

CV_MAX_SIZE_MB=5
PHOTO_MAX_SIZE_MB=2
FORWARD_MAX_ATTACHMENT_MB=15
FORWARD_MAX_CANDIDATES=50
RETENTION_MONTHS=12

TURNSTILE_SECRET_KEY=
SENTRY_LARAVEL_DSN=
